# Copy to .env and fill in. Every setting in backend/citadel/config.py can be set here.

# Storage: pgvector (Postgres) or local (numpy files, no database needed)
VECTOR_STORE=pgvector
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/citadel

# Ingestion
CHUNK_SIZE=400
CHUNK_OVERLAP=60

# Models
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval
TOP_K=5
RETRIEVAL_MODE=hybrid
RERANK=false

# Generation (Phase 2)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
